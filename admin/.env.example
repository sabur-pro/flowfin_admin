# ─── Для локальной разработки (npm run dev) ───────────────
# Адрес FlowFin API без /api на конце
API_BASE_URL=http://localhost:3000

# Имя куки с сессией администратора
SESSION_COOKIE_NAME=flowfin_admin


# ─── Для docker compose на сервере ────────────────────────
# Поддомен админки
ADMIN_HOST=admin.flowfin.intelligent.tj

# Почта для Let's Encrypt
LETSENCRYPT_EMAIL=meoutic@gmail.com

# Имя docker-сети бэкенда. Смотреть так:
#   docker network ls | grep backend
BACKEND_NETWORK=flowfin_back_backend-network

# Имя контейнера API в этой сети
API_CONTAINER=flowfin_api
